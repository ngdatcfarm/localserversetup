# CFarm Local Server — Environment Variables Template
#
# Copy this file to `.env` and fill in real values. The `.env` file is gitignored.
# On Windows, you can also set these as User-level environment variables instead.

# ── Cloudflare Tunnel ────────────────────────────────────────────
# Used by scripts/guardian.py, scripts/wrapper_cloudflared.py, scripts/diagnose_tunnel*.ps1
# Generate at: https://one.dash.cloudflare.com/ → Zero Trust → Networks → Tunnels
# → click your tunnel → Configure → "Install connector" → copy the token
CLOUDFLARE_TUNNEL_TOKEN=

# ── Session secret for webapp auth ───────────────────────────────
# Used by src/server/auth.py to sign session cookies. Should be ≥ 32 random chars.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
CFARM_SESSION_SECRET=

# ── Cookie Secure flag ───────────────────────────────────────────
# Set to "1" when running behind HTTPS (e.g. via Cloudflare Tunnel).
# When off (default), cookies are sent over HTTP too (LAN-only setups).
CFARM_COOKIE_SECURE=0

# ── Anthropic API (chatbot) ──────────────────────────────────────
# Used by src/server/routes/chat.py. Leave blank to disable AI features.
ANTHROPIC_API_KEY=
